<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC 
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN" 
    "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Настройки подключения -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/egor_service_db</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">9091991</property>
        
        <!-- Настройки генерации таблиц -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        <property name="show_sql">true</property>
        <property name="format_sql">true</property>

        <!-- КРИТИЧЕСКИ ВАЖНО: Добавьте ваш класс здесь -->
        <!-- Замените com.example.model.User на полный путь к вашему Entity классу -->
        <mapping class="com.example.model.User"/>

    </session-factory>
</hibernate-configuration>
